  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:tenant-isolation": "jest --testPathPattern=tests/tenant-isolation",
    "test:usage-tracking": "jest --testPathPattern=tests/usage --runInBand --forceExit",
    "test:usage": "jest --testPathPattern=tests/usage",
    "test:coverage": "jest --coverage",
    "test:compliance": "npx jest \"src/tests/(circuit-breaker|metrics|filtering).test.ts\" --env=node",
    "test:collaboration": "jest --testPathPattern=tests/collaboration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test:all": "jest",
    "create-next-partition": "ts-node src/scripts/create-next-partition.ts",
    "clean-ports": "node scripts/close-ports.js",
    "dev:clean": "npm run clean-ports && npm run dev",
    "super-clean": "taskkill /F /IM node.exe || true && rmdir /S /Q node_modules && rmdir /S /Q .next && npm cache clean --force && npm install && npm run dev"
  },
  "devDependencies": {
    "@types/ioredis": "^5.0.0",
